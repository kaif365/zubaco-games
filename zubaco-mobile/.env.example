# Zubaco Mobile Application Environment Configuration
# Copy this file to .env and adjust values for local development or production.

# Backend API Base URL
API_URL=http://localhost:3000/api/v1

# Real-time WebSocket Gateway URL
SOCKET_URL=http://localhost:3000

# Crash Reporting & Analytics
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Google OAuth Client ID (Web Client ID for Android/iOS Google Sign-In)
GOOGLE_WEB_CLIENT_ID=your-google-web-client-id.apps.googleusercontent.com
