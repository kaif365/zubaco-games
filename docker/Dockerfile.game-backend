# Game Backend Dockerfile (NestJS + Prisma)
# Multi-stage production build with unprivileged runtime user

ARG NODE_VERSION=22-alpine

# ─── Stage 1: Build ───
FROM node:${NODE_VERSION} AS builder

WORKDIR /app

COPY package*.json ./
RUN npm ci --legacy-peer-deps

COPY prisma ./prisma
RUN npx prisma generate 2>/dev/null || true

COPY tsconfig*.json ./
COPY nest-cli.json* ./
COPY src ./src

# Prefer npm run build if defined, otherwise fall back to tsc
RUN if grep -q '"build":' package.json; then npm run build; else npx tsc; fi

# ─── Stage 2: Production ───
FROM node:${NODE_VERSION} AS production

WORKDIR /app
ENV NODE_ENV=production

# Security: run as non-root user (appuser uid 1001)
RUN addgroup -g 1001 -S appgroup && \
    adduser -S appuser -u 1001 -G appgroup

COPY package*.json ./
RUN npm ci --legacy-peer-deps --omit=dev

# Copy compiled code, prisma engines, and generated client
COPY --from=builder --chown=appuser:appgroup /app/dist ./dist
COPY --from=builder --chown=appuser:appgroup /app/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder --chown=appuser:appgroup /app/generated* ./generated/
COPY --chown=appuser:appgroup prisma ./prisma

USER appuser

EXPOSE 3000

# Health check against standardized health endpoint
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://localhost:${PORT:-3000}/api/v1/health/live || \
      wget --no-verbose --tries=1 --spider http://localhost:${PORT:-3000}/health || exit 1

CMD ["node", "dist/main.js"]
