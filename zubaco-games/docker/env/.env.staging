# Zubaco — Staging Environment (production-like)
NODE_ENV=staging
PORT=3000

# Database (via PgBouncer)
DATABASE_URL=postgresql://zubaco_admin:${DB_PASSWORD}@${PGBOUNCER_HOST}:5432/zubaco_platform
DATABASE_DIRECT_URL=postgresql://zubaco_admin:${DB_PASSWORD}@${DB_HOST}:5432/zubaco_platform
DATABASE_POOL_SIZE=5

# Redis
REDIS_HOST=${REDIS_HOST}
REDIS_PORT=6379
REDIS_PASSWORD=${REDIS_PASSWORD}

# JWT
JWT_ACCESS_SECRET=${JWT_ACCESS_SECRET}
JWT_REFRESH_SECRET=${JWT_REFRESH_SECRET}
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# SMS
SMS_PROVIDER=msg91
SMS_API_KEY=${SMS_API_KEY}
SMS_TEMPLATE_ID=${SMS_TEMPLATE_ID}

# Google OAuth
GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}
GOOGLE_CLIENT_SECRET=${GOOGLE_CLIENT_SECRET}

# Razorpay (test mode)
RAZORPAY_KEY_ID=${RAZORPAY_KEY_ID}
RAZORPAY_KEY_SECRET=${RAZORPAY_KEY_SECRET}
RAZORPAY_WEBHOOK_SECRET=${RAZORPAY_WEBHOOK_SECRET}

# Internal API Key
INTERNAL_API_KEY=${INTERNAL_API_KEY}

# FCM
FCM_SERVER_KEY=${FCM_SERVER_KEY}

# AWS
AWS_REGION=ap-south-1
AWS_S3_BUCKET=zubaco-assets-staging
