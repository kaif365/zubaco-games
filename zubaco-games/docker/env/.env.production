# Zubaco — Production Environment
# ALL secrets must come from AWS Secrets Manager / environment variables
# This file serves as a template — do NOT commit real values
NODE_ENV=production
PORT=3000

# Database (via PgBouncer for connection pooling)
DATABASE_URL=postgresql://zubaco_admin:${DB_PASSWORD}@${PGBOUNCER_HOST}:5432/zubaco_platform
DATABASE_DIRECT_URL=postgresql://zubaco_admin:${DB_PASSWORD}@${DB_HOST}:5432/zubaco_platform
DATABASE_POOL_SIZE=5

# Redis (ElastiCache, encrypted in-transit)
REDIS_HOST=${REDIS_HOST}
REDIS_PORT=6379
REDIS_PASSWORD=${REDIS_PASSWORD}

# JWT
JWT_ACCESS_SECRET=${JWT_ACCESS_SECRET}
JWT_REFRESH_SECRET=${JWT_REFRESH_SECRET}
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# SMS
SMS_PROVIDER=msg91
SMS_API_KEY=${SMS_API_KEY}
SMS_TEMPLATE_ID=${SMS_TEMPLATE_ID}

# Google OAuth
GOOGLE_CLIENT_ID=${GOOGLE_CLIENT_ID}
GOOGLE_CLIENT_SECRET=${GOOGLE_CLIENT_SECRET}

# Apple Sign In
APPLE_CLIENT_ID=${APPLE_CLIENT_ID}
APPLE_TEAM_ID=${APPLE_TEAM_ID}
APPLE_KEY_ID=${APPLE_KEY_ID}

# Razorpay (live mode)
RAZORPAY_KEY_ID=${RAZORPAY_KEY_ID}
RAZORPAY_KEY_SECRET=${RAZORPAY_KEY_SECRET}
RAZORPAY_WEBHOOK_SECRET=${RAZORPAY_WEBHOOK_SECRET}

# Internal API Key
INTERNAL_API_KEY=${INTERNAL_API_KEY}

# FCM
FCM_SERVER_KEY=${FCM_SERVER_KEY}

# Sentry
SENTRY_DSN=${SENTRY_DSN}

# AWS
AWS_REGION=ap-south-1
AWS_S3_BUCKET=zubaco-assets-production
