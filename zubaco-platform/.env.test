# ─────────────────────────────────────────────────────────────────────────────
# TEST-ONLY environment. Safe to commit — contains NO production credentials.
# Consumed by the local test scripts (scripts/test-db-push.js, seed-test.js) and
# by the integration jest bootstrap. CI sets these values inline per step.
# ─────────────────────────────────────────────────────────────────────────────

# Points at the SEPARATE test database provisioned by docker-compose.test.yml.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/zubaco_test?schema=public

# Redis (docker-compose.test.yml exposes it on localhost:6379).
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Throwaway JWT secrets (>= 32 chars). NOT used to protect anything real.
JWT_ACCESS_SECRET=test-access-secret-min-32-characters-000
JWT_REFRESH_SECRET=test-refresh-secret-min-32-characters-00
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

NODE_ENV=test
PORT=3000
INTERNAL_API_KEY=test-internal-key

# Webhook outbox — deterministic (zero backoff) for integration tests.
BASE_PLATFORM_WEBHOOK_URL=https://base-platform.example.test/webhook
WEBHOOK_SIGNING_SECRET=integration-webhook-signing-secret
WEBHOOK_MAX_ATTEMPTS=3
WEBHOOK_BACKOFF_BASE_SECONDS=0
WEBHOOK_BACKOFF_MAX_SECONDS=0
WEBHOOK_TIMEOUT_MS=2000
